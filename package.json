{
  "name": "deepcopilot-desktop",
  "displayName": "Deep Copilot Desktop",
  "description": "Deep Copilot — AI coding agent desktop app. Powered by DeepSeek V4.",
  "version": "0.1.0",
  "author": "Deep Copilot Contributors",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build": "node esbuild.config.js",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.0",
    "glob": "^10.4.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.0",
    "@vscode/codicons": "^0.0.45",
    "dompurify": "^3.4.2",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.0",
    "esbuild": "^0.28.0",
    "katex": "^0.16.45"
  },
  "build": {
    "appId": "com.deepcopilot.desktop",
    "productName": "Deep Copilot",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "webview/**/*",
      "imgs/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "sign": null,
      "verifyUpdateCodeSignature": false
    },
    "portable": {
      "artifactName": "DeepCopilot.exe"
    }
  }
}
